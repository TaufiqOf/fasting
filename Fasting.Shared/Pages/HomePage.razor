@page "/"

@using System.Globalization
@using Fasting.Models

<PageTitle>Fasting Dashboard</PageTitle>

<div class="container py-4">

    <div class="d-flex
                flex-column
                flex-md-row
                justify-content-between
                align-items-md-center
                gap-3
                mb-4">

        <div>
            <p class="text-muted mb-1">
                @Greeting
            </p>

            <h1 class="h2 mb-1">
                Fasting Dashboard
            </h1>

            <p class="text-muted mb-0">
                Track your current fast and recent progress.
            </p>
        </div>

        <a class="btn btn-primary"
           href="/fasting">

            <span class="bi bi-hourglass-split me-2"
                  aria-hidden="true">
            </span>

            @(FastingManager.HasActiveCycle
                ? "View Current Fast"
                : "Start a Fast")
        </a>
    </div>

    @if (FastingManager.HasActiveCycle)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">

                <div class="d-flex
                            flex-column
                            flex-md-row
                            justify-content-between
                            align-items-md-start
                            gap-3
                            mb-4">

                    <div>
                        <div class="d-flex
                                    align-items-center
                                    gap-2
                                    mb-2">

                            <span class="badge
                                         @(FastingManager.IsFasting
                                             ? "bg-primary"
                                             : "bg-success")">

                                @(FastingManager.IsFasting
                                    ? "Fasting"
                                    : "Eating")
                            </span>

                            <span class="text-muted small">
                                Active cycle
                            </span>
                        </div>

                        <h2 class="h4 mb-1">
                            @FastingManager.ActiveType?.Name
                        </h2>

                        <p class="text-muted mb-0">
                            @PhaseDescription
                        </p>
                    </div>

                    <div class="text-md-end">
                        <div class="display-6 fw-bold">
                            @FastingManager.ProgressPercentage.ToString("0")%
                        </div>

                        <small class="text-muted">
                            completed
                        </small>
                    </div>
                </div>

                <div class="text-center mb-4">
                    <div class="display-4 fw-bold">
                        @ElapsedTimeText
                    </div>

                    <div class="text-muted">
                        elapsed time
                    </div>
                </div>

                <div class="progress mb-3"
                     role="progressbar"
                     aria-label="Current cycle progress"
                     aria-valuenow="@FastingManager.ProgressPercentage"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     style="height: 1.5rem;">

                    <div class="progress-bar
                                progress-bar-striped
                                progress-bar-animated"
                         style="width: @(ProgressWidth)%;
                                background-color: @FastingManager.ProgressColor;">
                    </div>
                </div>

                <div class="row g-3">

                    <div class="col-12 col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small mb-1">
                                @RemainingLabel
                            </div>

                            <div class="fw-semibold">
                                @RemainingTimeText
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small mb-1">
                                Current stage
                            </div>

                            <div class="fw-semibold">
                                @FastingManager.FastingTip
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body
                        d-flex
                        flex-column
                        flex-lg-row
                        align-items-lg-center
                        gap-3
                        p-4">

                <div class="fs-1 text-primary">
                    <span class="bi bi-hourglass"></span>
                </div>

                <div>
                    <h2 class="h4 mb-1">
                        No active fast
                    </h2>

                    <p class="text-muted mb-0">
                        Start a fasting cycle to begin tracking your progress.
                    </p>
                </div>

                <a class="btn btn-primary ms-lg-auto"
                   href="/fasting">
                    Start Fasting
                </a>
            </div>
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-start">

                        <div>
                            <div class="text-muted small">
                                Current streak
                            </div>

                            <div class="fs-2 fw-bold">
                                @CurrentStreak
                            </div>

                            <div class="text-muted">
                                @(CurrentStreak == 1 ? "day" : "days")
                            </div>
                        </div>

                        <span class="bi bi-fire fs-2 text-warning">
                        </span>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-start">

                        <div>
                            <div class="text-muted small">
                                Longest fast
                            </div>

                            <div class="fs-2 fw-bold">
                                @LongestFastText
                            </div>

                            <div class="text-muted">
                                Personal best
                            </div>
                        </div>

                        <span class="bi bi-trophy-fill fs-2 text-warning">
                        </span>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-start">

                        <div>
                            <div class="text-muted small">
                                This month
                            </div>

                            <div class="fs-2 fw-bold">
                                @CompletedThisMonth
                            </div>

                            <div class="text-muted">
                                Targets reached
                            </div>
                        </div>

                        <span class="bi bi-calendar-check fs-2 text-success">
                        </span>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-start">

                        <div>
                            <div class="text-muted small">
                                Total fasts
                            </div>

                            <div class="fs-2 fw-bold">
                                @TotalCompletedFasts
                            </div>

                            <div class="text-muted">
                                Targets reached
                            </div>
                        </div>

                        <span class="bi bi-bar-chart-fill fs-2 text-primary">
                        </span>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <div class="row g-4">

        <div class="col-12 col-xl-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-center
                                gap-3
                                mb-3">

                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="ShowPreviousMonth">
                            ‹
                        </button>

                        <h2 class="h5 mb-0">
                            @DisplayedMonth.ToString(
                                "MMMM yyyy",
                                CultureInfo.CurrentCulture)
                        </h2>

                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="ShowNextMonth">
                            ›
                        </button>
                    </div>

                    <div class="calendar-grid calendar-weekdays">
                        @foreach (string weekday in WeekdayNames)
                        {
                            <div>@weekday</div>
                        }
                    </div>

                    <div class="calendar-grid">
                        @foreach (DashboardCalendarDay day in CalendarDays)
                        {
                            <div class="@GetCalendarDayCss(day)"
                                 title="@GetCalendarDayTooltip(day)">

                                <span class="day-number">
                                    @day.Date.Day
                                </span>

                                @if (day.TargetReached)
                                {
                                    <span class="bi
                                                 bi-check-circle-fill
                                                 completed-indicator">
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <div class="d-flex
                                align-items-center
                                gap-2
                                mt-3
                                small
                                text-muted">

                        <span class="legend-completed"></span>
                        Fasting target reached
                    </div>

                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">

                    <div class="d-flex
                                justify-content-between
                                align-items-center
                                gap-3
                                mb-3">

                        <div>
                            <h2 class="h5 mb-1">
                                Recent activity
                            </h2>

                            <small class="text-muted">
                                Your latest completed fasts
                            </small>
                        </div>

                        <a href="/fasting"
                           class="btn btn-sm btn-outline-primary">
                            View all
                        </a>
                    </div>

                    @if (RecentHistory.Count == 0)
                    {
                        <div class="text-center py-5">
                            <span class="bi
                                         bi-clock-history
                                         fs-1
                                         text-muted">
                            </span>

                            <p class="text-muted mt-3 mb-0">
                                No completed fasts yet.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">

                            @foreach (FastingHistoryEntry entry in RecentHistory)
                            {
                                <div class="list-group-item px-0">

                                    <div class="d-flex
                                                justify-content-between
                                                align-items-start
                                                gap-3">

                                        <div class="d-flex gap-3">

                                            <div class="activity-icon
                                                        @(entry.TargetReached
                                                            ? "activity-success"
                                                            : "activity-secondary")">

                                                <span class="bi
                                                             @(entry.TargetReached
                                                                 ? "bi-check-lg"
                                                                 : "bi-x-lg")">
                                                </span>
                                            </div>

                                            <div>
                                                <div class="fw-semibold">
                                                    @entry.FastingTypeName
                                                </div>

                                                <div class="small text-muted">
                                                    @FormatDuration(entry.Duration)
                                                </div>
                                            </div>
                                        </div>

                                        <div class="text-end">
                                            <div class="small">
                                                @FormatRelativeDate(entry.EndedAt)
                                            </div>

                                            <span class="badge
                                                         @(entry.TargetReached
                                                             ? "bg-success"
                                                             : "bg-secondary")">

                                                @(entry.TargetReached
                                                    ? "Reached"
                                                    : "Not reached")
                                            </span>
                                        </div>

                                    </div>
                                </div>
                            }

                        </div>
                    }

                </div>
            </div>
        </div>

    </div>
</div>