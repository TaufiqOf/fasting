@page "/settings"

<PageTitle>Profile Settings</PageTitle>

<div class="container py-4">

    <div class="mb-4">
        <h1 class="h2 mb-1">Profile Settings</h1>

        <p class="text-muted mb-0">
            Enter your details to personalize your fasting dashboard.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                    <EditForm Model="Profile"
                              OnValidSubmit="SaveSettingsAsync">

                        <DataAnnotationsValidator />
                        <ValidationSummary class="alert alert-danger" />

                        <div class="mb-4 text-center">
                            <div class="profile-icon mx-auto mb-3">
                                <span class="bi bi-person-fill"></span>
                            </div>

                            <h2 class="h5 mb-1">
                                Personal information
                            </h2>

                            <p class="text-muted small mb-0">
                                This information is saved on your device.
                            </p>
                        </div>

                        <div class="row g-3">

                            <div class="col-12 col-md-6">
                                <label for="height"
                                       class="form-label">
                                    Height
                                </label>

                                <div class="input-group">
                                    <InputNumber id="height"
                                                 class="form-control"
                                                 @bind-Value="Profile.HeightCm" />

                                    <span class="input-group-text">
                                        cm
                                    </span>
                                </div>

                                <ValidationMessage For="@(() => Profile.HeightCm)" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label for="age"
                                       class="form-label">
                                    Age
                                </label>

                                <div class="input-group">
                                    <InputNumber id="age"
                                                 class="form-control"
                                                 @bind-Value="Profile.Age" />

                                    <span class="input-group-text">
                                        years
                                    </span>
                                </div>

                                <ValidationMessage For="@(() => Profile.Age)" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label for="weight"
                                       class="form-label">
                                    Current weight
                                </label>

                                <div class="input-group">
                                    <InputNumber id="weight"
                                                 class="form-control"
                                                 step="0.1"
                                                 @bind-Value="Profile.WeightKg" />

                                    <span class="input-group-text">
                                        kg
                                    </span>
                                </div>

                                <ValidationMessage For="@(() => Profile.WeightKg)" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label for="targetWeight"
                                       class="form-label">
                                    Target weight
                                </label>

                                <div class="input-group">
                                    <InputNumber id="targetWeight"
                                                 class="form-control"
                                                 step="0.1"
                                                 @bind-Value="Profile.TargetWeightKg" />

                                    <span class="input-group-text">
                                        kg
                                    </span>
                                </div>

                                <ValidationMessage For="@(() => Profile.TargetWeightKg)" />
                            </div>

                            <div class="col-12">
                                <label for="gender"
                                       class="form-label">
                                    Gender
                                </label>

                                <InputSelect id="gender"
                                             class="form-select"
                                             @bind-Value="Profile.Gender">

                                    <option value="">
                                        Select gender
                                    </option>

                                    @foreach (string gender in GenderOptions)
                                    {
                                        <option value="@gender">
                                            @gender
                                        </option>
                                    }

                                </InputSelect>

                                <ValidationMessage For="@(() => Profile.Gender)" />
                            </div>

                        </div>

                        @if (Profile.HeightCm > 0 &&
                             Profile.WeightKg > 0)
                        {
                            <div class="profile-summary mt-4">

                                <div>
                                    <span class="summary-label">
                                        Body mass index
                                    </span>

                                    <strong class="summary-value">
                                        @BodyMassIndex.ToString("0.0")
                                    </strong>
                                </div>

                                <div>
                                    <span class="summary-label">
                                        Weight goal
                                    </span>

                                    <strong class="summary-value">
                                        @WeightGoalText
                                    </strong>
                                </div>

                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(StatusMessage))
                        {
                            <div class="alert @(SaveSucceeded
                                                  ? "alert-success"
                                                  : "alert-danger")
                                        mt-4
                                        mb-0">

                                <span class="bi
                                             @(SaveSucceeded
                                                 ? "bi-check-circle-fill"
                                                 : "bi-exclamation-circle-fill")
                                             me-2">
                                </span>

                                @StatusMessage
                            </div>
                        }

                        <div class="d-grid
                                    d-sm-flex
                                    justify-content-sm-end
                                    gap-2
                                    mt-4">

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    @onclick="ResetForm">
                                Reset
                            </button>

                            <button type="submit"
                                    class="btn btn-primary"
                                    disabled="@IsSaving">

                                @if (IsSaving)
                                {
                                    <span class="spinner-border
                                                 spinner-border-sm
                                                 me-2"
                                          aria-hidden="true">
                                    </span>

                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <span class="bi bi-floppy-fill me-2"></span>
                                    <span>Save Settings</span>
                                }

                            </button>

                        </div>

                    </EditForm>

                </div>
            </div>

        </div>
    </div>
</div>